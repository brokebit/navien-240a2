    {
      "type": "timeseries",
      "title": "Hot water per day",
      "description": "From the hourly totals: complete hours only, so up to an hour behind.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"water_dhw_l\") / 3.78541 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Hot water",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gal",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hot water"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
