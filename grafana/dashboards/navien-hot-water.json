{
  "uid": "navien-hot-water",
  "title": "Navien — Hot water",
  "description": "Hot-water draws: when, how much, how long, how fast hot.",
  "tags": [
    "navien"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "influxdb",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "options": [],
        "current": {
          "text": "influxdb-navien",
          "value": "influxdb-navien"
        }
      },
      {
        "type": "constant",
        "name": "tz",
        "query": "America/Chicago",
        "hide": 2,
        "current": {
          "text": "America/Chicago",
          "value": "America/Chicago"
        },
        "options": []
      },
      {
        "type": "textbox",
        "name": "shower_min_s",
        "label": "Shower ≥ s",
        "query": "240",
        "hide": 0,
        "current": {
          "text": "240",
          "value": "240"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "navien"
      ],
      "asDropdown": false,
      "title": "Navien",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Hot water per hour",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"water_dhw_l\") / 3.78541 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1h) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Hot water",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gal",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hot water"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "id": 1
    },
    {
      "type": "barchart",
      "title": "Hot water by hour of day (total over the range)",
      "description": "Each complete hour's gallons, added up by local hour of day. Needs Grafana 10.4+ (Format time transformation).",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"water_dhw_l\") / 3.78541 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1h) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Gallons",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gal",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Time",
        "orientation": "vertical",
        "showValue": "never",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelSpacing": 0
      },
      "transformations": [
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "HH",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Time": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Gallons": {
                "aggregations": [
                  "sum"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Draws and showers per day",
      "description": "Showers: draws of at least $shower_min_s seconds.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT COUNT(\"duration_s\") FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Draws",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT COUNT(\"duration_s\") FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND \"duration_s\" >= $shower_min_s AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Showers",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "id": 3
    },
    {
      "type": "histogram",
      "title": "Draw duration",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"duration_s\" / 60 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "combine": true
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 4
    },
    {
      "type": "histogram",
      "title": "Draw volume",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"volume_l\" / 3.78541 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gal",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "combine": true
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Time to hot",
      "description": "From the start of a draw until the outlet is within 1 °C of the setpoint. Missing for draws that never got there.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"time_to_hot_s\" FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Time to hot",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Draws",
      "description": "One row per draw, newest first. Units = 2: the slave was called in.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"duration_s\", \"volume_l\" / 3.78541 AS \"gal\", \"peak_flow_lpm\" / 3.78541 AS \"gpm\", \"mean_outlet_c\" * 9 / 5 + 32 AS \"outlet_f\", \"min_inlet_c\" * 9 / 5 + 32 AS \"inlet_f\", \"time_to_hot_s\", \"gas_kcal\" / 25200 AS \"therms\", \"units_max\", \"truncated\" FROM \"forever\".\"navien_event\" WHERE \"type\" = 'draw' AND $timeFilter ORDER BY time DESC",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Duration"
              },
              {
