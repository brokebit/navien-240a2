          },
          {
            "matcher": {
              "id": "byName",
              "options": "outlet_f"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Mean outlet"
              },
              {
                "id": "unit",
                "value": "fahrenheit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inlet_f"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lowest inlet"
              },
              {
                "id": "unit",
                "value": "fahrenheit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time_to_hot_s"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time to hot"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "therms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Gas"
              },
              {
                "id": "unit",
