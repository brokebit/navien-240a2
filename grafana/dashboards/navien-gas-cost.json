          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_recirc_kcal\") / 25200 * $price_per_therm FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Recirculation",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": -1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hot water"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recirculation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Gas per week",
      "description": "InfluxQL has no calendar months; weeks start on Thursday (epoch weeks).",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_dhw_kcal\") / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1w) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Hot water",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_recirc_kcal\") / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1w) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Recirculation",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: thm",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
