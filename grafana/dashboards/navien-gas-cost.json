{
  "uid": "navien-gas",
  "title": "Navien — Gas & cost",
  "description": "Gas use and cost by purpose, gas per gallon, supply temperature.",
  "tags": [
    "navien"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "influxdb",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "type": "constant",
        "name": "tz",
        "query": "America/Chicago",
        "hide": 2,
        "current": {
          "text": "America/Chicago",
          "value": "America/Chicago"
        },
        "options": []
      },
      {
        "type": "textbox",
        "name": "price_per_therm",
        "label": "Gas $/therm",
        "query": "1.50",
        "hide": 0,
        "current": {
          "text": "1.50",
          "value": "1.50"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "navien"
      ],
      "asDropdown": false,
      "title": "Navien",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Gas",
      "description": "From the hourly totals: complete hours only, so up to an hour behind.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT (SUM(\"gas_dhw_kcal\") + SUM(\"gas_recirc_kcal\") + SUM(\"gas_other_kcal\")) / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: thm",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Cost",
      "description": "At $price_per_therm per therm (dashboard variable).",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT (SUM(\"gas_dhw_kcal\") + SUM(\"gas_recirc_kcal\") + SUM(\"gas_other_kcal\")) / 25200 * $price_per_therm FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Recirculation share",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_recirc_kcal\") / (SUM(\"gas_dhw_kcal\") + SUM(\"gas_recirc_kcal\")) * 100 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Gas per gallon of hot water",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_dhw_kcal\") * 3.96832 / (SUM(\"water_dhw_l\") / 3.78541) FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: BTU/gal",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Gas per day",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_dhw_kcal\") / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Hot water",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_recirc_kcal\") / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Recirculation",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_other_kcal\") / 25200 FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Other",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: thm",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "barAlignment": -1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hot water"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recirculation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Cost per day",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT SUM(\"gas_dhw_kcal\") / 25200 * $price_per_therm FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = 'all' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Hot water",
          "refId": "A"
        },
