          "query": "SELECT MEAN(\"d\") FROM (SELECT (\"outlet_c\" - \"set_c\") * 9 / 5 AS \"d\" FROM \"samples_90d\".\"navien_unit\" WHERE \"unit\" = '0' AND \"flow_dhw_lpm\" > 0 AND $timeFilter) WHERE $timeFilter GROUP BY time($__interval)",
