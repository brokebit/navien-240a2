    {
      "type": "timeseries",
      "title": "Bus errors per minute",
      "description": "Port reopens: the adapter delivered nothing for serial.stall_reopen_s and was reopened. Counted when data is back (no bus points while it is silent).",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT NON_NEGATIVE_DIFFERENCE(LAST(\"checksum_fail\")) FROM \"forever\".\"navien_bus\" WHERE $timeFilter GROUP BY time(1m) fill(none)",
