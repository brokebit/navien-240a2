      "type": "table",
      "title": "Runs",
      "description": "Unit 0 = master, 1 = slave.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"unit\", \"duration_s\", \"volume_l\" / 3.78541 AS \"gal\", \"gas_kcal\" / 25200 AS \"therms\", \"start_inlet_c\" * 9 / 5 + 32 AS \"start_f\", \"end_outlet_c\" * 9 / 5 + 32 AS \"end_f\", \"since_last_s\" / 60 AS \"since_m\" FROM \"forever\".\"navien_event\" WHERE \"type\" = 'recirc' AND $timeFilter ORDER BY time DESC",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": "",
          "refId": "A"
