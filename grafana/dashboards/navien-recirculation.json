          "query": "SELECT SUM(\"gas_recirc_kcal\") / 25200 * $price_per_therm FROM \"forever\".\"navien_hourly\" WHERE \"unit\" = '0' AND $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "rawQuery": true,
