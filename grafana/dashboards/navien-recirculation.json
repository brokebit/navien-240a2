    {
      "type": "timeseries",
      "title": "Loop temperature at start / end",
      "description": "Inlet when the run starts (how cold the loop got) and outlet when it ends.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"start_inlet_c\" * 9 / 5 + 32 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'recirc' AND \"unit\" = '0' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Master start",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"start_inlet_c\" * 9 / 5 + 32 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'recirc' AND \"unit\" = '1' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Slave start",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"end_outlet_c\" * 9 / 5 + 32 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'recirc' AND \"unit\" = '0' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Master end",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "SELECT \"end_outlet_c\" * 9 / 5 + 32 FROM \"forever\".\"navien_event\" WHERE \"type\" = 'recirc' AND \"unit\" = '1' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Slave end",
          "refId": "D"
        }
