#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl stop navien-dash.service || true
    if [ "$1" = "remove" ]; then
        systemctl disable navien-dash.service || true
    fi
fi
# Bytecode written by postinst is not tracked by dpkg.
find /opt/navien-dash -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
